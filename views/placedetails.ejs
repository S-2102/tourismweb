<%- include("static/header.ejs") %>

  <section class="place-details">
  <div class="title-icon">
    <h1><%= place.name %></h1>
    <div class="icon">
    
        <button class="place-details-button direction" data-lat="<%= place.lat %>"
            data-lon="<%= place.lon %>"
            data-id="<%= place.id %>">
            
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="20px"
            viewBox="0 -960 960 960"
            width="20px"
            fill="currentColor"
          >
            <path
              d="M480-80q-106 0-173-33.5T240-200q0-24 14.5-44.5T295-280l63 59q-9 4-19.5 9T322-200q13 16 60 28t98 12q51 0 98.5-12t60.5-28q-7-8-18-13t-21-9l62-60q28 16 43 36.5t15 45.5q0 53-67 86.5T480-80Zm1-220q99-73 149-146.5T680-594q0-102-65-154t-135-52q-70 0-135 52t-65 154q0 67 49 139.5T481-300Zm-1 100Q339-304 269.5-402T200-594q0-71 25.5-124.5T291-808q40-36 90-54t99-18q49 0 99 18t90 54q40 36 65.5 89.5T760-594q0 94-69.5 192T480-200Zm0-320q33 0 56.5-23.5T560-600q0-33-23.5-56.5T480-680q-33 0-56.5 23.5T400-600q0 33 23.5 56.5T480-520Zm0-80Z"
            />
          </svg>
        </button>

      <button class="place-details-button review">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          height="20px"
          viewBox="0 -960 960 960"
          width="20px"
          fill="currentColor"
        >
          <path
            d="M240-400h122l200-200q9-9 13.5-20.5T580-643q0-11-5-21.5T562-684l-36-38q-9-9-20-13.5t-23-4.5q-11 0-22.5 4.5T440-722L240-522v122Zm280-243-37-37 37 37ZM300-460v-38l101-101 20 18 18 20-101 101h-38Zm121-121 18 20-38-38 20 18Zm26 181h273v-80H527l-80 80ZM80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z"
          />
        </svg>
      </button>

      <button class="place-details-button details-save-button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          height="20px"
          viewBox="0 -960 960 960"
          width="20px"
          fill="currentColor"
        >
          <path
            d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z"
          />
        </svg>
      </button>
    </div>
  </div>
  <div class="place-description">
    <p class="location-details">
      <svg
        version="1.1"
        id="Capa_1"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        width="14px"
        height="14"
        viewBox="0 0 425.963 425.963"
        xml:space="preserve"
        stroke="#ffffff"
        transform="rotate(0)"
      >
        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
        <g
          id="SVGRepo_tracerCarrier"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></g>
        <g id="SVGRepo_iconCarrier">
          <g>
            <path
              d="M213.285,0h-0.608C139.114,0,79.268,59.826,79.268,133.361c0,48.202,21.952,111.817,65.246,189.081 c32.098,57.281,64.646,101.152,64.972,101.588c0.906,1.217,2.334,1.934,3.847,1.934c0.043,0,0.087,0,0.13-0.002 c1.561-0.043,3.002-0.842,3.868-2.143c0.321-0.486,32.637-49.287,64.517-108.976c43.03-80.563,64.848-141.624,64.848-181.482 C346.693,59.825,286.846,0,213.285,0z M274.865,136.62c0,34.124-27.761,61.884-61.885,61.884 c-34.123,0-61.884-27.761-61.884-61.884s27.761-61.884,61.884-61.884C247.104,74.736,274.865,102.497,274.865,136.62z"
            ></path>
          </g>
        </g>
      </svg>
      <%= place.address %>
    </p>
    <% if (place.rating){ %>
    <p class="rating"><img src="/icons/staricon.svg" /><%= place.rating %></p>
    <% } %>
  </div>

  <div class="place-images">
    <div class="slider" id="slider">
      <% place.images.forEach((img, index) => { %>
        <img src="<%= img %>" alt="Image <%= index + 1 %>">
      <% }) %>
    </div>
    <button class="arrow left" id="leftArrow">&#8592;</button>
    <button class="arrow right" id="rightArrow">&#8594;</button>
  </div>

  <div class="dots" id="dotsContainer"></div>

  <div class="description">
    <h2 class="place-details-title">About The Place</h2>
    <p><%= place.description %></p>
    <% if (place.hours){ %>
    <p><%= place.hours %></p>
    <% } %> <% if (place.contact){ %>
    <p><%= place.contact %></p>
    <% } %> <% if (place.priceRange){ %>
    <p><%= place.priceRange %></p>
    <% } %>
  </div>
</section>

<!-- modal -->
 <div class="place-modal" id="imageModal">
  <span class="modal-close" id="closeModal">&times;</span>
  <div class="modal-content" id="modalContent"></div>
  <span class="modal-arrow left" id="modalPrev">&#8592;</span>
  <span class="modal-arrow right" id="modalNext">&#8594;</span>
  <div class="modal-dots" id="modalDots"></div>
</div>

<%- include("static/footer.ejs") %>
