  <%- include("static/header.ejs") %>
  <section class="hero-section">
    <div class="container-fluid">

      <div id="carouselExampleAutoplaying" class="carousel slide carousel-fade" data-bs-ride="carousel"
        data-bs-touch="true">
        <div class="carousel-indicators">
          <button type="button" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
            class="active" aria-current="true" aria-label="Slide 1"></button>
          <button type="button" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
            aria-label="Slide 2"></button>
          <button type="button" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
            aria-label="Slide 3"></button>
          <button type="button" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
            aria-label="Slide 4"></button>
        </div>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="/images/Gallery/batasialoopToytrain.jpg" class="d-block w-100" alt="Himalayan Toy Train">
            <div class="dark-overlay"></div>
          </div>
          <div class="carousel-item">
            <img src="/images/places/japanesetemple/supratik-deshmukh-57zZADm8pcY-unsplash.jpg"
              class="d-block w-100" alt="...">
              <div class="dark-overlay"></div>
          </div>
          <div class="carousel-item">
            <img src="/images/Gallery/kanchenjungha.jpg" class="d-block w-100" alt="...">
            <div class="dark-overlay"></div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- explore -->
  <section class="explore">
    <div class="explore-title">
      <h2>Top Attractions</h2> <button type="button" class="button"><a href="/placelist">Explore All</a></button>
    </div>

    <div class="top-attractions">
      <div class="carousel-attractions-container">
        <button type="button" class="arrow left leftArrow">&#8592;</button>
        <div class="carousel-attractions-attractions-track">
        <% topAttractions.forEach(attraction=>{ %>
          <a href="/placedetails/<%= attraction.id %>" class="carousel-attractions-card">
            <img src="<%= attraction.images[0] %>" alt="<%= attraction.name %>" />
            <button type="button" class="save-button"><svg xmlns="http://www.w3.org/2000/svg" height="24px"
                viewBox="0 -960 960 960" width="24px" fill="#FFFFFF">
                <path
                  d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z" />
              </svg></button>
            <p class="attractions-title"><%= attraction.name %></p>
          </a>
       <% }) %>
        </div>
        <button type="button" class="arrow right rightArrow">&#8594;</button>
      </div>
    </div>

    <!-- restaurants -->
    <div class="explore-title">
      <h2>Where to eat in Darjeeling? </h2> <button type="button" class="button"><a href="/placelist">Explore
          All</a></button>
    </div>
    <div class="TopPlaces">
      <button type="button" class="arrow left leftArrow"><svg xmlns="http://www.w3.org/2000/svg" height="24px"
          viewBox="0 -960 960 960" width="24px" fill="#FFFFFF">
          <path d="M360-200 80-480l280-280 56 56-183 184h647v80H233l184 184-57 56Z" />
        </svg></button>
      <div class="scroll-snap">
        <% topRestaurants.forEach(place=>{ %>
        <a href="/placedetails/<%= place.id %>">
          <div class="cardPlaces">
            <img class="cardImage" id="<%= place.id %>" src="<%= place.images[0] %>"
              alt="<%= place.name %>" />
            <button type="button" class="save-button"><svg xmlns="http://www.w3.org/2000/svg" height="24px"
                viewBox="0 -960 960 960" width="24px" fill="#FFFFFF">
                <path
                  d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z" />
              </svg></button>
              <h3 class="placeTitle"><%= place.name %></h3>
              <p class="hours"><strong>Open:</strong><%= place.hours %>
              </p>
          </div>
        </a>
        <% }) %>
      </div>
      <button type="button" class="arrow right rightArrow"><svg xmlns="http://www.w3.org/2000/svg" height="24px"
          viewBox="0 -960 960 960" width="24px" fill="#FFFFFF">
          <path d="m600-200-57-56 184-184H80v-80h647L544-704l56-56 280 280-280 280Z" />
        </svg>
      </button>
    </div>
  </section>

  <!-- gallery -->
   <section id="gallery">
    <div class="container">
      <div class="swiper gallery-slider">
        <div class="swiper-wrapper">
          <% gallery.forEach(item => { %>
            <div class="swiper-slide gallery-slide">
              <div class="gallery-slide-img">
                <img src="<%= item.image %>" alt="<%= item.title %>" />

              </div>
                <div class="gallery-slide-content-bottom">
                  <h2 class="image-name"><%= item.title %></h2>
                </div>
            </div>
          <% }) %>
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>
    </div>
  </section>

<%- include("static/footer.ejs") %>