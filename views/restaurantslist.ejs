  <%- include("static/header.ejs") %>
  
  <div class="placelist-heading"><h1>PLACES TO VISIT</h1></div>
  <section class="places-lists">
     <% restaurants.forEach(r=>{ %>
    <a href="/placedetails/<%= r.id%>">
      <div class="places-list-cards" id="<%= r.id%>">
        <button type="button" class="save-button"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#FFFFFF"><path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z"/></svg></button>
        <img  src="<%= r.images[0] %>" alt="<%=r.name %>">
        <p class="location"><img src="/icons/locsvg.svg" alt="Location Icon"><%= r.address %></p>
        <div class="placelist-description">
          <h3 class="place-list-title"><%=r.name %></h3>
          <p class="rating">Rating : <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#FFD700">
          <path d="M12 2L14.9 8.62L22 9.24L17 14.14L18.2 21.02L12 17.77L5.8 21.02L7 14.14L2 9.24L9.1 8.62L12 2Z"/>
        </svg><%= r.rating %></p>
        </div>
      </div>
    </a>
  <%})%>
    </section>
<%- include("static/footer.ejs") %>