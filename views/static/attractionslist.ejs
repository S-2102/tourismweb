  <%- include("static/header.ejs") %>
  
  <div class="placelist-heading"><h1>PLACES TO VISIT</h1></div>
  <section class="places-lists">
     <% attractions.forEach(a=>{ %>
    <a href="/placedetails/<%= a.id%>">
      <div class="places-list-cards" id="<%= a.id%>">
        <button type="button" class="save-button"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#FFFFFF"><path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z"/></svg></button>
        <img  src="<%= a.images[0]%>" alt="<%=a.name %>">
        <p class="location"><img src="/icons/locsvg.svg" alt="Location Icon"><%= a.address %></p>
        <h3 class="title"><%=a.name %></h3>
      </div>
    </a>
  <%})%>
    </section>
<%- include("static/footer.ejs") %>