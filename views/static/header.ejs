    <div id="searchbox">
      <input type="search" role="search" id="search-bar" placeholder="Find Place">
      <button type="button" id="search-button">
        <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill=" #1c352d">
          <path
            d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z" />
        </svg>
      </button>
    </div>
    <button type="button" class="button" id="nav-action" data-bs-toggle="modal" data-bs-target="#authModal"
      data-bs-backdrop="static">Login</button>
  </nav>
  </header>
    <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="position-relative">
          <button type="button" type="button" class="custom-close" data-bs-dismiss="modal" aria-label="Close">✖
          </button>
        </div>

        <div class="modal-body">
          <div class="auth-container">
            <!-- Left Image -->
            <div class="auth-img d-none d-md-block"></div>

            <!-- Right Form Area -->
            <div class="auth-form">
              <!-- Login Form -->
              <div class="form-box login active">
                <form action="/login" method="post">
                  <h1>Welcome Back!</h1>

                  <div class="input-box">
                    <input type="email" name="email" placeholder="email@gmail.com" required />
                    <i class="bx bxs-envelope"></i>
                  </div>

                  <div class="input-box">
                    <input type="password" name="password" placeholder="Password" required />
                    <i class="bx bxs-lock"></i>
                  </div>
                  <div class="d-flex justify-content-center">
                    <button type="submit" name="action" value="login"  class="auth-btn">Login</button>
                  </div>

                  <div class="auth-footer">
                    <p>Don't have an account? <a href="javascript:void(0)" id="showSignup">Sign up</a></p>
                    <p>
                      <a href="#">Forgot password?</a>
                    </p>
                  </div>
                </form>
              </div>

              <!-- Signup Form -->
              <div class="form-box register">
                <form action="/register" method="post">
                  <h1>Welcome !</h1>

                  <div class="input-box">
                    <input type="email" name="email" placeholder="email@gmail.com" required />
                    <i class="bx bxs-envelope"></i>
                  </div>

                  <div class="input-box">
                    <input type="password" name="password" placeholder="Password" required />
                    <i class="bx bxs-lock"></i>
                  </div>
                  <div class="d-flex justify-content-center">
                    <button type="submit" name="action" value="signup" class="auth-btn">Sign up</button>
                  </div>

                  <div class="auth-footer">
                    <p>
                      Already have an account? <a href="javascript:void(0)" id="showLogin">Login</a>
                    </p>

                    </p>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="main">